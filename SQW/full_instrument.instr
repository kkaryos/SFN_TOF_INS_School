 width = analyser_width, height = analyser_height,
 order = 1)
AT (0, 0, 0) RELATIVE ana_arm6
ROTATED (0, -A5, 0) RELATIVE ana_arm6
GROUP analysers

COMPONENT monochromator7 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
