* 
* %Parameters
* pulse_length: [unit] Proton pulse duration for the moderator model [s]
* moderator_tau: [unit] Cold moderator decay time used by Source_pulsed [s]
* moderator_n: [unit] Cold moderator pulse-shape parameter used by Source_pulsed
* source_frequency: [unit] Source repetition rate [Hz]
* lambda_min: [unit] Minimum source wavelength [Angstrom]
* lambda_max: [unit] Maximum source wavelength [Angstrom]
* source_t_max: [unit] End of Source_pulsed emission-time sampling window [s]
* linx: [unit] Horizontal upstream focal distance [m]
* liny: [unit] Vertical upstream focal distance [m]
* loutx: [unit] Horizontal downstream focal distance [m]
* louty: [unit] Vertical downstream focal distance [m]
* guide_length: [unit] Length of the uninterrupted elliptic guide [m]
* guide_xwidth: [unit] Horizontal guide dimension at mid-length [m]
* guide_yheight: [unit] Vertical guide dimension at mid-length [m]
* d_source_guide: [unit] Source-to-guide entrance distance [m]
* d_guide_sample: [unit] Guide exit-to-sample distance [m]
* lambda_f: [unit] Analyser-selected wavelength [Angstrom]
* channel_angle: [unit] Sample-to-analyser direction [degrees]
* d_sample_analyser: [unit] Sample-to-analyser distance [m]
* analyser_d: [unit] Analyser lattice spacing [Angstrom]
* analyser_width: [unit] Total analyser width [m]
* analyser_height: [unit] Total analyser height [m]
* analyser_mosaic_h: [unit] Horizontal mosaic [arcmin]
* analyser_mosaic_v: [unit] Vertical mosaic [arcmin]
* analyser_NH: [unit] Horizontal blade count
* analyser_NV: [unit] Vertical blade count
* analyser_gap: [unit] Blade gap [m]
* analyser_detector_distance: [unit] FANTASTIC L2: separation along fixed detector arm [m]
* detector_x: [unit] Combined tube width [m]
* detector_y: [unit] Tube height [m]
* sample_radius: [unit] Sample radius [m]
* sample_height: [unit] Sample height [m]
* sample_rotation_x: [unit] Sample x rotation [degrees]
* sample_rotation_y: [unit] Sample y rotation [degrees]
* sample_rotation_z: [unit] Sample z rotation [degrees]
* sample_f_QE: [unit] Quasielastic fraction
* sample_f_tun: [unit] Tunneling fraction; elastic fraction is the remainder
* sample_gamma: [unit] Quasielastic Lorentzian HWHM [meV]
* sample_E_tun: [unit] Tunneling energy [meV]
* analyser_focusing: [unit] 1: FANTASTIC focusing radii; 0: flat analyser
* sample_rho: [unit] S(Q,w) scattering-unit number density [Angstrom^-3]
* offset: [unit] Rotation of the complete analyser bank [degrees]
* 
* %Link 
* 
* %End 
********************************************************************************/

DEFINE INSTRUMENT full_instrument (
pulse_length = 0.0004, // Proton pulse duration for the moderator model [s]
moderator_tau = 0.00017, // Cold moderator decay time used by Source_pulsed [s]
moderator_n = 5.0, // Cold moderator pulse-shape parameter used by Source_pulsed
source_frequency = 50.0, // Source repetition rate [Hz]
lambda_min = 2.0, // Minimum source wavelength [Angstrom]
lambda_max = 4.0, // Maximum source wavelength [Angstrom]
double source_t_max = 0.004, // End of Source_pulsed emission-time sampling window [s]
double linx = 0.611423, // Horizontal upstream focal distance [m]
double liny = 1.04627, // Vertical upstream focal distance [m]
double loutx = 1.68246, // Horizontal downstream focal distance [m]
double louty = 1.94531, // Vertical downstream focal distance [m]
double guide_length = 35.0, // Length of the uninterrupted elliptic guide [m]
double guide_xwidth = 0.12, // Horizontal guide dimension at mid-length [m]
double guide_yheight = 0.12, // Vertical guide dimension at mid-length [m]
double d_source_guide = 0.5, // Source-to-guide entrance distance [m]
double d_guide_sample = 1.5, // Guide exit-to-sample distance [m]
double lambda_f = 4.0, // Analyser-selected wavelength [Angstrom]
double channel_angle = 30.0, // Sample-to-analyser direction [degrees]
double d_sample_analyser = 0.858, // Sample-to-analyser distance [m]
double analyser_d = 3.357, // Analyser lattice spacing [Angstrom]
double analyser_width = 0.07, // Total analyser width [m]
double analyser_height = 0.03, // Total analyser height [m]
double analyser_mosaic_h = 30.0, // Horizontal mosaic [arcmin]
double analyser_mosaic_v = 30.0, // Vertical mosaic [arcmin]
int analyser_NH = 11, // Horizontal blade count
int analyser_NV = 11, // Vertical blade count
double analyser_gap = 0.0005, // Blade gap [m]
double analyser_detector_distance = 0.5, // FANTASTIC L2: separation along fixed detector arm [m]
double detector_x = 0.038099999999999995, // Combined tube width [m]
double detector_y = 0.5588, // Tube height [m]
double sample_radius = 0.01, // Sample radius [m]
double sample_height = 0.02, // Sample height [m]
double sample_rotation_x = 0.0, // Sample x rotation [degrees]
double sample_rotation_y = 0.0, // Sample y rotation [degrees]
double sample_rotation_z = 0.0, // Sample z rotation [degrees]
double sample_f_QE = 0, // Quasielastic fraction
double sample_f_tun = 0, // Tunneling fraction; elastic fraction is the remainder
double sample_gamma = 0, // Quasielastic Lorentzian HWHM [meV]
double sample_E_tun = 5, // Tunneling energy [meV]
double analyser_focusing = 1, // 1: FANTASTIC focusing radii; 0: flat analyser
double sample_rho = 0.05, // S(Q,w) scattering-unit number density [Angstrom^-3]
double offset = 0.0 // Rotation of the complete analyser bank [degrees]
)

DECLARE 
%{
double A5;
double analyser_RH;
double analyser_RV;
double L_primary_channel;
double tube_tmin;
double tube_tmax;
char tube_options[1024];
double detector_deflection;
double detector_ray_path;
double tube_center_y;
double detector_hit_x;
double detector_hit_y;
double detector_hit_z;
%}

INITIALIZE 
%{
// Start of initialize for generated full_instrument
if (lambda_min <= 0 || lambda_max <= lambda_min || source_frequency <= 0 || pulse_length <= 0 || moderator_tau <= 0 || moderator_n <= 1 || source_t_max <= 0) { fprintf(stderr, "Invalid source parameters\n"); exit(1); }
if (guide_length <= 0 || guide_xwidth <= 0 || guide_yheight <= 0 || d_source_guide <= 0 || d_guide_sample < 0 || linx <= 0 || liny <= 0 || loutx <= 0 || louty <= 0) { fprintf(stderr, "Invalid elliptic-guide geometry\n"); exit(1); }
if (lambda_f <= 0 || analyser_d <= 0 || lambda_f >= 2*analyser_d || d_sample_analyser <= 0 || analyser_detector_distance <= 0 || analyser_width <= 0 || analyser_height <= 0 || analyser_NH < 1 || analyser_NV < 1 || analyser_gap < 0 || analyser_mosaic_h <= 0 || analyser_mosaic_v <= 0 || detector_x <= 0 || detector_y <= 0 || sample_radius <= 0 || sample_height <= 0) { fprintf(stderr, "Invalid secondary-channel parameters\n"); exit(1); }
A5 = asin(lambda_f/(2.0*analyser_d))*180.0/PI;
detector_deflection = 2.0*A5;
if (sin(DEG2RAD*detector_deflection) <= 1e-8) { fprintf(stderr, "Detector intersection is undefined at this Bragg angle\n"); exit(1); }
detector_ray_path = analyser_detector_distance/sin(DEG2RAD*detector_deflection);
tube_center_y = -analyser_detector_distance/tan(DEG2RAD*detector_deflection);
detector_hit_x = (d_sample_analyser - tube_center_y)*sin(DEG2RAD*(offset + 60.0));
detector_hit_y = -analyser_detector_distance;
detector_hit_z = (d_sample_analyser - tube_center_y)*cos(DEG2RAD*(offset + 60.0));
printf("FANTASTIC fixed -90 deg detector arm: 2A5=%g deg; ray path=%g m; predicted ray local y=%g m (diagnostic only); ray intersection relative to sample=(%g,%g,%g) m\n", detector_deflection, detector_ray_path, tube_center_y, detector_hit_x, detector_hit_y, detector_hit_z);
if (analyser_focusing != 0 && analyser_focusing != 1) { fprintf(stderr, "analyser_focusing must be 0 or 1\n"); exit(1); }
analyser_RH = analyser_focusing ? -d_sample_analyser : 0.0;
analyser_RV = analyser_focusing ? -2.0*d_sample_analyser*sin(DEG2RAD*A5) : 0.0;
L_primary_channel = d_source_guide + guide_length + d_guide_sample;
tube_tmin = 0.02338220424671385;
tube_tmax = 0.04338220424671385;
snprintf(tube_options, sizeof(tube_options), "cylinder, y, bins=2, t, limits=[%.17g %.17g], bins=1000", tube_tmin, tube_tmax);
printf("30 analysers: lambda_f=%g A, A5=%g deg, RH=%g m, RV=%g m, detector interval=[%g,%g] ms\n", lambda_f, A5, analyser_RH, analyser_RV, 1e3*tube_tmin, 1e3*tube_tmax);
if (sample_f_QE < 0 || sample_f_tun < 0 || sample_f_QE + sample_f_tun > 1 || sample_gamma < 0 || (sample_f_QE > 0 && sample_gamma <= 0) || sample_E_tun < 0) { fprintf(stderr, "Invalid tunneling fractions, width, or energy\n"); exit(1); }
if (sample_f_QE == 0 && sample_f_tun == 0 && (lambda_f < lambda_min || lambda_f > lambda_max)) { printf("NOTE: Pure elastic sample with lambda_f=%g A outside source wavelength range [%g,%g] A; weak or zero elastic signal is expected\n", lambda_f, lambda_min, lambda_max); }
if (source_t_max <= 0) { fprintf(stderr, "source_t_max must be positive\n"); exit(1); }
if (sample_rho <= 0) { fprintf(stderr, "sample_rho must be positive\n"); exit(1); }
%}

TRACE 
COMPONENT source = Source_pulsed(
 xwidth = 0.042, yheight = 0.03,
 Lmin = lambda_min, Lmax = lambda_max,
 t_min = 0.0, t_max = source_t_max,
 dist = d_source_guide, focus_xw = 0.04,
 focus_yh = 0.04, freq = source_frequency,
 t_pulse = pulse_length, T1 = 60.0,
 I1 = 1.75e12/source_frequency, tau1 = moderator_tau,
 n_mod = moderator_n, I_um = 3.82e10/source_frequency,
 tau_um = 1.2e-05, n_um = 5.0,
 chi_um = 0.9, kap_um = 2.2)
AT (0, 0, 0) ABSOLUTE

COMPONENT guide = Elliptic_guide_gravity(
 xwidth = guide_xwidth, yheight = guide_yheight,
 l = guide_length, linxw = linx,
 loutxw = loutx, linyh = liny,
 loutyh = louty, dimensionsAt = "mid",
 option = "ellipse", R0 = 0.99,
 Qc = 0.0218, alpha = 6.07,
 m = 4, W = 0.003)
AT (0, 0, d_source_guide) RELATIVE source

COMPONENT guide_out = Arm()
AT (0, 0, guide_length) RELATIVE guide

COMPONENT sample_position = Arm()
AT (0, 0, d_guide_sample) RELATIVE guide_out

COMPONENT sample_sqw = Isotropic_Sqw(
 Sqw_coh = "SQW.dat", radius = sample_radius,
 thickness = 0.0, yheight = sample_height,
 order = 1, d_phi = 3,
 rho = sample_rho, p_interact = 1.0)
AT (0, 0, 0) RELATIVE sample_position
ROTATED (sample_rotation_x, sample_rotation_y, sample_rotation_z) RELATIVE sample_position
EXTEND %{
if (!SCATTERED) { ABSORB; }
%}

COMPONENT ana_arm0 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 0)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 0))) RELATIVE sample_position
ROTATED (0, offset + 0, 90) RELATIVE sample_position

COMPONENT ana_arm1 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 4)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 4))) RELATIVE sample_position
ROTATED (0, offset + 4, 90) RELATIVE sample_position

COMPONENT ana_arm2 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 8)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 8))) RELATIVE sample_position
ROTATED (0, offset + 8, 90) RELATIVE sample_position

COMPONENT ana_arm3 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 12)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 12))) RELATIVE sample_position
ROTATED (0, offset + 12, 90) RELATIVE sample_position

COMPONENT ana_arm4 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 16)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 16))) RELATIVE sample_position
ROTATED (0, offset + 16, 90) RELATIVE sample_position

COMPONENT ana_arm5 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 20)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 20))) RELATIVE sample_position
ROTATED (0, offset + 20, 90) RELATIVE sample_position

COMPONENT ana_arm6 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 24)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 24))) RELATIVE sample_position
ROTATED (0, offset + 24, 90) RELATIVE sample_position

COMPONENT ana_arm7 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 28)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 28))) RELATIVE sample_position
ROTATED (0, offset + 28, 90) RELATIVE sample_position

COMPONENT ana_arm8 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 32)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 32))) RELATIVE sample_position
ROTATED (0, offset + 32, 90) RELATIVE sample_position

COMPONENT ana_arm9 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 36)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 36))) RELATIVE sample_position
ROTATED (0, offset + 36, 90) RELATIVE sample_position

COMPONENT ana_arm10 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 40)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 40))) RELATIVE sample_position
ROTATED (0, offset + 40, 90) RELATIVE sample_position

COMPONENT ana_arm11 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 44)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 44))) RELATIVE sample_position
ROTATED (0, offset + 44, 90) RELATIVE sample_position

COMPONENT ana_arm12 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 48)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 48))) RELATIVE sample_position
ROTATED (0, offset + 48, 90) RELATIVE sample_position

COMPONENT ana_arm13 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 52)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 52))) RELATIVE sample_position
ROTATED (0, offset + 52, 90) RELATIVE sample_position

COMPONENT ana_arm14 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 56)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 56))) RELATIVE sample_position
ROTATED (0, offset + 56, 90) RELATIVE sample_position

COMPONENT ana_arm15 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 60)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 60))) RELATIVE sample_position
ROTATED (0, offset + 60, 90) RELATIVE sample_position

COMPONENT ana_arm16 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 64)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 64))) RELATIVE sample_position
ROTATED (0, offset + 64, 90) RELATIVE sample_position

COMPONENT ana_arm17 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 68)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 68))) RELATIVE sample_position
ROTATED (0, offset + 68, 90) RELATIVE sample_position

COMPONENT ana_arm18 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 72)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 72))) RELATIVE sample_position
ROTATED (0, offset + 72, 90) RELATIVE sample_position

COMPONENT ana_arm19 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 76)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 76))) RELATIVE sample_position
ROTATED (0, offset + 76, 90) RELATIVE sample_position

COMPONENT ana_arm20 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 80)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 80))) RELATIVE sample_position
ROTATED (0, offset + 80, 90) RELATIVE sample_position

COMPONENT ana_arm21 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 84)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 84))) RELATIVE sample_position
ROTATED (0, offset + 84, 90) RELATIVE sample_position

COMPONENT ana_arm22 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 88)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 88))) RELATIVE sample_position
ROTATED (0, offset + 88, 90) RELATIVE sample_position

COMPONENT ana_arm23 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 92)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 92))) RELATIVE sample_position
ROTATED (0, offset + 92, 90) RELATIVE sample_position

COMPONENT ana_arm24 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 96)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 96))) RELATIVE sample_position
ROTATED (0, offset + 96, 90) RELATIVE sample_position

COMPONENT ana_arm25 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 100)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 100))) RELATIVE sample_position
ROTATED (0, offset + 100, 90) RELATIVE sample_position

COMPONENT ana_arm26 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 104)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 104))) RELATIVE sample_position
ROTATED (0, offset + 104, 90) RELATIVE sample_position

COMPONENT ana_arm27 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 108)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 108))) RELATIVE sample_position
ROTATED (0, offset + 108, 90) RELATIVE sample_position

COMPONENT ana_arm28 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 112)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 112))) RELATIVE sample_position
ROTATED (0, offset + 112, 90) RELATIVE sample_position

COMPONENT ana_arm29 = Arm()
AT (d_sample_analyser*sin(DEG2RAD*(offset + 116)), 0, d_sample_analyser*cos(DEG2RAD*(offset + 116))) RELATIVE sample_position
ROTATED (0, offset + 116, 90) RELATIVE sample_position

COMPONENT monochromator0 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
 NV = analyser_NV, mosaich = analyser_mosaic_h,
 mosaicv = analyser_mosaic_v, r0 = 0.99,
 t0 = 1.0, RV = analyser_RV,
 RH = analyser_RH, DM = analyser_d,
 width = analyser_width, height = analyser_height,
 order = 1)
AT (0, 0, 0) RELATIVE ana_arm0
ROTATED (0, -A5, 0) RELATIVE ana_arm0
GROUP analysers

COMPONENT monochromator1 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
 NV = analyser_NV, mosaich = analyser_mosaic_h,
 mosaicv = analyser_mosaic_v, r0 = 0.99,
 t0 = 1.0, RV = analyser_RV,
 RH = analyser_RH, DM = analyser_d,
 width = analyser_width, height = analyser_height,
 order = 1)
AT (0, 0, 0) RELATIVE ana_arm1
ROTATED (0, -A5, 0) RELATIVE ana_arm1
GROUP analysers

COMPONENT monochromator2 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
 NV = analyser_NV, mosaich = analyser_mosaic_h,
 mosaicv = analyser_mosaic_v, r0 = 0.99,
 t0 = 1.0, RV = analyser_RV,
 RH = analyser_RH, DM = analyser_d,
 width = analyser_width, height = analyser_height,
 order = 1)
AT (0, 0, 0) RELATIVE ana_arm2
ROTATED (0, -A5, 0) RELATIVE ana_arm2
GROUP analysers

COMPONENT monochromator3 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
