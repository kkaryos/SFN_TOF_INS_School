 order = 1)
AT (0, 0, 0) RELATIVE ana_arm4
ROTATED (0, -A5, 0) RELATIVE ana_arm4
GROUP analysers

COMPONENT monochromator5 = Monochromator_curved(
 gap = analyser_gap, NH = analyser_NH,
